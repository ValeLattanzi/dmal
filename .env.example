# Sepolia RPC URL (obtén gratis desde Alchemy, Infura o QuickNode)
# https://alchemy.com → crear app → seleccionar Sepolia → copiar URL
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Tu clave privada de MetaMask (NUNCA la compartas)
# En MetaMask: Cuenta → Detalles → Exportar clave privada
PRIVATE_KEY=0x...

# API Key de Etherscan (obtén gratis desde etherscan.io/apidashboard)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
