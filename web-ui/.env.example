VITE_DIPLOMA_ADDRESS=0x4E0A77e01F85c24d87c3605e1dFD09EaF62d1B00
VITE_COMPOSITION_ADDRESS=0x484FCeA1e42D9997b8E98c5007214c160BFD90D2

# IPFS Gateway (para lectura de archivos)
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs

# Backend API (Spring Boot)
VITE_API_URL=http://localhost:8080

# Logging
VITE_LOG_LEVEL=debug
