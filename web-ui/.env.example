# Blockchain RPC Endpoint
VITE_RPC_URL=http://localhost:8545
# o para Sepolia testnet:
# VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Chain ID (1 = mainnet, 11155111 = sepolia, 31337 = hardhat local)
